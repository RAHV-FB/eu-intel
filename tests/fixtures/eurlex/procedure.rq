  { ?dos cdm:dossier_produces_resource_legal ?w }
  UNION { ?w cdm:resource_legal_produced_by_dossier ?dos }
  UNION { ?w cdm:resource_legal_adopts_resource_legal ?prop . ?prop cdm:work_part_of_dossier ?dos }
